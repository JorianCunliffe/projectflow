{
  "rules": {
    "invites": {
      "$token": {
        ".read": "auth != null && auth.token.firebase.sign_in_provider != 'anonymous'",
        ".write": "auth != null && auth.token.firebase.sign_in_provider != 'anonymous' && (!newData.exists() || (data.exists() ? true : root.child('users').child(auth.uid).child('orgId').val() === newData.child('orgId').val()))"
      }
    },
    "projects": {
      "$orgId": {
        ".read": "auth != null && auth.token.firebase.sign_in_provider != 'anonymous' && root.child('users').child(auth.uid).child('orgId').val() === $orgId",
        ".write": "auth != null && auth.token.firebase.sign_in_provider != 'anonymous' && root.child('users').child(auth.uid).child('orgId').val() === $orgId"
      }
    },
    "users": {
      "$uid": {
        ".read": "auth != null && $uid === auth.uid",
        ".write": "auth != null && auth.token.firebase.sign_in_provider != 'anonymous' && $uid === auth.uid"
      }
    },
    "organizations": {
      "$orgId": {
        ".read": "auth != null && auth.token.firebase.sign_in_provider != 'anonymous' && root.child('users').child(auth.uid).child('orgId').val() === $orgId",
        ".write": "auth != null && auth.token.firebase.sign_in_provider != 'anonymous' && (root.child('users').child(auth.uid).child('orgId').val() === $orgId || !data.exists())"
      }
    },
    "accounts": {
      ".read": false,
      ".write": false
    }
  }
}
